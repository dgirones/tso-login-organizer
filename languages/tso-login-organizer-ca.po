msgid ""
msgstr "Project-Id-Version: TSO Login Organizer 1.0.0\nLanguage: ca\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "<strong>Error:</strong> Captcha verification failed."
msgstr "<strong>Error:</strong> La verificació del captcha ha fallat."

msgid "<strong>Error:</strong> Enter your two-factor authentication code."
msgstr "<strong>Error:</strong> Introduïu el codi d’autenticació de dos factors."

msgid "<strong>Error:</strong> Invalid two-factor code."
msgstr "<strong>Error:</strong> Codi de dos factors no vàlid."

msgid "<strong>Error:</strong> Password must be at least %d characters."
msgstr "<strong>Error:</strong> La contrasenya ha de tenir almenys %d caràcters."

msgid "<strong>Error:</strong> Passwords do not match."
msgstr "<strong>Error:</strong> Les contrasenyes no coincideixen."

msgid "<strong>Error:</strong> Please complete the captcha."
msgstr "<strong>Error:</strong> Completeu el captcha."

msgid "<strong>Error:</strong> Please confirm your email before logging in."
msgstr "<strong>Error:</strong> Confirmeu el correu abans d’iniciar la sessió."

msgid "<strong>Error:</strong> Please enter a password."
msgstr "<strong>Error:</strong> Introduïu una contrasenya."

msgid "<strong>Error:</strong> Please enter a username, not an email address."
msgstr "<strong>Error:</strong> Introduïu un nom d’usuari, no un correu."

msgid "<strong>Error:</strong> Please enter a valid email address."
msgstr "<strong>Error:</strong> Introduïu un correu electrònic vàlid."

msgid "<strong>Error:</strong> The passwords do not match."
msgstr "<strong>Error:</strong> Les contrasenyes no coincideixen."

msgid "<strong>Error:</strong> Too many failed login attempts. Please try again later."
msgstr "<strong>Error:</strong> Massa intents fallits. Torneu-ho a provar més tard."

msgid "<strong>Error:</strong> User registration is currently not allowed."
msgstr "<strong>Error:</strong> El registre d’usuaris no està permès actualment."

msgid "<strong>Error:</strong> Your account is awaiting admin approval."
msgstr "<strong>Error:</strong> El vostre compte espera l’aprovació de l’administrador."

msgid "A new tab with the module name appears at the top of this page. Open it to configure options (keys, URLs, checkboxes, etc.)."
msgstr "Apareix una pestanya nova amb el nom del mòdul a dalt de la pàgina. Obriu-la per configurar opcions (claus, URL, caselles, etc.)."

msgid "API key"
msgstr "Clau API"

msgid "Account"
msgstr "Compte"

msgid "Action"
msgstr "Acció"

msgid "Add the Facebook Login product to the app."
msgstr "Afegiu el producte Facebook Login a l’app."

msgid "Add the X callback URL below as a Callback URI / Redirect URL."
msgstr "Afegiu l’URL de callback d’X a sota com a Callback URI / Redirect URL."

msgid "Add to Menu"
msgstr "Afegeix al menú"

msgid "Add to favorites"
msgstr "Afegeix als preferits"

msgid "Admin approval"
msgstr "Aprovació de l’administrador"

msgid "Admin approval leaves the account pending on the Users screen until an administrator approves it."
msgstr "L’aprovació de l’administrador deixa el compte pendent a Usuaris fins que un administrador l’aprovi."

msgid "After a successful registration the new person is signed in immediately. If Moderation has email confirmation or admin approval turned on, this box is ignored and they stay logged out until that step is finished."
msgstr "Després d’un registre correcte la persona nova inicia sessió de seguida. Si Moderació té confirmació per correu o aprovació activa, aquesta casella s’ignora i roman desconnectada fins que acabi aquell pas."

msgid "After import: trash the old Theme My Login WordPress pages, keep pretty permalinks, then open each virtual URL from Core → URL slugs to confirm forms load."
msgstr "Després de la importació: envieu a la paperera les pàgines antigues de Theme My Login, mantingueu enllaços permanents amigables i obriu cada URL virtual des de Nucli → Slugs d’URL per confirmar els formularis."

msgid "After login"
msgstr "Després d’iniciar sessió"

msgid "After logout"
msgstr "Després de tancar sessió"

msgid "After registration"
msgstr "Després del registre"

msgid "After that, login asks for the password and for the 6-digit code shown in the app."
msgstr "Després, l’inici de sessió demana la contrasenya i el codi de 6 dígits de l’aplicació."

msgid "Allow users to set a password at registration"
msgstr "Permetre que els usuaris defineixin una contrasenya al registre"

msgid "Also adds a captcha or anti-spam check on forms. Two checks on the same form often fail verification."
msgstr "També afegeix captcha o antispam als formularis. Dues comprovacions al mateix formulari solen fallar."

msgid "Also adds social login buttons or OAuth callbacks. Buttons can be duplicated or the return URL can be stolen by the other plugin."
msgstr "També afegeix botons d’accés social o retorns OAuth. Els botons es poden duplicar o l’altra extensió pot capturar l’URL de retorn."

msgid "Also asks for a second code at login. Two authenticators on the same account block sign-in."
msgstr "També demana un segon codi a l’entrada. Dos autenticadors al mateix compte bloquegen l’accés."

msgid "Also blocks login until a registration is approved (wp_authenticate_user). Keep only one approval plugin active."
msgstr "També bloqueja l’entrada fins a aprovar el registre (wp_authenticate_user). Deixeu només un plugin d’aprovació actiu."

msgid "Also blocks wp-admin or replaces the profile screen. Subscribers may be unable to reach either profile."
msgstr "També bloqueja wp-admin o substitueix la pantalla de perfil. Els subscriptors poden no arribar a cap perfil."

msgid "Also forces login or restricts content. Guests may be redirected twice or locked out of pages."
msgstr "També força l’entrada o restringeix contingut. Els visitants poden redirigir-se dues vegades o quedar fora de pàgines."

msgid "Also locks out failed logins or hides wp-login.php. Running both can block legitimate users or hide the login URL twice."
msgstr "També bloqueja inicis fallits o amaga wp-login.php. Tots dos junts poden bloquejar usuaris vàlids o amagar l’URL d’accés dues vegades."

msgid "Also replaces outgoing email content. The message saved here may be wrapped or discarded."
msgstr "També substitueix el contingut dels correus sortints. El missatge desat aquí pot embolcallar-se o descartar-se."

msgid "Also replaces the profile photo (get_avatar). One of the two pictures will win and the other upload may look ignored."
msgstr "També substitueix la foto de perfil (get_avatar). Una de les dues imatges guanya i l’altra pujada pot semblar ignorada."

msgid "Also sends new users to Mailchimp. The same person can be subscribed twice."
msgstr "També envia usuaris nous a Mailchimp. La mateixa persona pot subscriure’s dues vegades."

msgid "Also sends users somewhere after login, logout or registration. The last plugin to run decides the final URL."
msgstr "També envia usuaris després d’entrar, sortir o registrar-se. L’últim plugin decideix l’URL final."

msgid "Also stores favorite posts. The buttons and the list page may disagree about what is saved."
msgstr "També desa entrades preferides. Els botons i la pàgina de llista poden no coincidir."

msgid "Anyone can register"
msgstr "Qualsevol pot registrar-se"

msgid "Ask for newsletter consent on the registration form"
msgstr "Demanar consentiment del butlletí al formulari de registre"

msgid "Audience / list ID where new subscribers are added."
msgstr "ID de l’audiència / llista on s’afegeixen els nous subscriptors."

msgid "Authentication code"
msgstr "Codi d’autenticació"

msgid "Authenticator"
msgstr "Autenticador"

msgid "Auto login"
msgstr "Inici de sessió automàtic"

msgid "Avatar file is too large."
msgstr "El fitxer de l’avatar és massa gran."

msgid "Avatar updated."
msgstr "Avatar actualitzat."

msgid "Avatars"
msgstr "Avatars"

msgid "Avatars needs Profiles. The upload field is on the profile page, not on this screen. Max size (KB) below is the only setting here."
msgstr "Avatars necessita Perfils. El camp de pujada és a la pàgina de perfil, no aquí. La mida màxima (KB) és l’únic ajust d’aquesta pantalla."

msgid "Block wp-admin"
msgstr "Bloquejar wp-admin"

msgid "Block wp-admin prevents those users from reaching wp-admin screens (including other plugins’ profile tabs). Prefer frontend setup for 2FA when this is on."
msgstr "Bloquejar wp-admin impedeix arribar a pantalles d’admin (inclosos altres plugins). Preferiu configurar el 2FA al frontend."

msgid "Block wp-admin sends users who cannot edit posts away from /wp-admin/ to that profile page and hides the admin bar."
msgstr "Bloquejar wp-admin envia els usuaris sense edit_posts fora de /wp-admin/ a aquella pàgina de perfil i amaga la barra d’administració."

msgid "Brute force"
msgstr "Força bruta"

msgid "Buttons are injected into post content; page builders that replace the_content may hide them — use the favorites page URL as a fallback."
msgstr "Els botons s’injecten al contingut; constructors de pàgines que substitueixen the_content poden amagar-los — useu la URL de preferits."

msgid "Caching plugins may serve public HTML to guests; exclude restricted pages or disable cache for logged-out users when testing."
msgstr "Els plugins de cache poden servir HTML públic als visitants; excloeu pàgines restringides o desactiveu la cache en proves."

msgid "Check friendly URLs"
msgstr "Comprova les URL amigables"

msgid "Check the box and update the profile to turn two-factor on. A key is created only then. The user must add that key to an authenticator app. The next login will ask for the password and for the 6-digit code from the app. Leaving the box unchecked changes nothing."
msgstr "Marqueu la casella i actualitzeu el perfil per activar el doble factor. La clau es crea només llavors. L’usuari l’ha d’afegir a una app d’autenticació. El proper inici demanarà la contrasenya i el codi de 6 dígits. Si deixeu la casella sense marcar, no canvia res."

msgid "Check your email"
msgstr "Consulteu el correu"

msgid "Check your email for the confirmation link."
msgstr "Consulteu el correu per al enllaç de confirmació."

msgid "Click “Check friendly URLs” to refresh rewrite rules. If this warning stays, open Settings → Permalinks, choose Post name (structure /%postname%/), and click Save Changes."
msgstr "Feu clic a «Comprova les URL amigables» per refrescar les regles. Si l’avís continua, obriu Configuració → Enllaços permanents, trieu Nom de l’entrada (/%postname%/) i deseu."

msgid "Compatibility"
msgstr "Compatibilitat"

msgid "Configure the OAuth consent screen (External or Internal) and add your test users if needed."
msgstr "Configureu la pantalla de consentiment OAuth (External o Internal) i afegiu usuaris de prova si cal."

msgid "Confirm Password"
msgstr "Confirmeu la contrasenya"

msgid "Confirm privacy request"
msgstr "Confirmar sol·licitud de privadesa"

msgid "Confirm your email"
msgstr "Confirmeu el correu"

msgid "Conflicts with other WordPress 2FA / TOTP plugins on the same accounts."
msgstr "Entra en conflicte amb altres plugins 2FA / TOTP de WordPress als mateixos comptes."

msgid "Conflicts with other registration-approval plugins that also block wp_authenticate_user."
msgstr "Entra en conflicte amb altres plugins d’aprovació de registres que també bloquegen wp_authenticate_user."

msgid "Continue with Facebook"
msgstr "Continua amb Facebook"

msgid "Continue with Google"
msgstr "Continua amb Google"

msgid "Continue with X"
msgstr "Continua amb X"

msgid "Copy Client ID and Client Secret into the fields below, then Save."
msgstr "Copieu Client ID i Client Secret als camps de sota i deseu."

msgid "Copy Client ID and Client secret into the fields below, then Save."
msgstr "Copieu l’ID de client i el secret als camps de sota i deseu."

msgid "Core"
msgstr "Nucli"

msgid "Core settings saved."
msgstr "Configuració del nucli desada."

msgid "Correct setup: Settings → Permalinks → Post name. The structure box should contain /%postname%/. Then click Save Changes on that screen."
msgstr "Configuració correcta: Configuració → Enllaços permanents → Nom de l’entrada. El camp ha de contenir /%postname%/. Després deseu."

msgid "Create a Project and App with OAuth 2.0 enabled."
msgstr "Creeu un Projecte i una App amb OAuth 2.0 activat."

msgid "Create a v2 \"I'm not a robot\" key, then paste both values here."
msgstr "Creeu una clau v2 «No sóc un robot» i enganxeu aquí els dos valors."

msgid "Create an API key at https://admin.mailchimp.com/account/api/ and copy the Audience (list) ID from Audience → Settings."
msgstr "Creeu una clau API a https://admin.mailchimp.com/account/api/ i copieu l’ID d’audiència (llista) des d’Audience → Settings."

msgid "Create an app (type Consumer / Authenticate and request data from users with Facebook Login)."
msgstr "Creeu una app (tipus Consumer / Authenticate and request data from users with Facebook Login)."

msgid "Create credentials → OAuth client ID → Application type: Web application."
msgstr "Creeu credencials → ID de client OAuth → Tipus d’aplicació: Aplicació web."

msgid "Current profile picture"
msgstr "Imatge de perfil actual"

msgid "Customize welcome and password-reset emails (subject, body, optional HTML)."
msgstr "Personalitzeu els correus de benvinguda i de restabliment de contrasenya (assumpte, cos, HTML opcional)."

msgid "Dashboard"
msgstr "Tauler"

msgid "Default (all roles)"
msgstr "Per defecte (tots els rols)"

msgid "Default applies to every role that does not have its own address. A role box overrides Default only for people with that role."
msgstr "Per defecte s’aplica a cada rol sense adreça pròpia. Un camp per rol substitueix el valor per defecte només per a aquell rol."

msgid "Default form:"
msgstr "Formulari per defecte:"

msgid "Delivery"
msgstr "Entrega"

msgid "Display Name"
msgstr "Nom visible"

msgid "Do not combine with Swiss Knife custom login URL or other plugins that rename wp-login.php."
msgstr "No ho combineu amb l’URL d’accés personalitzat de Swiss Knife ni amb altres plugins que canviïn wp-login.php."

msgid "Do not create WordPress pages for these slugs — they are created virtually. You can delete Theme My Login pages with the same names. Profile and Favorites rewrite only when those modules are enabled."
msgstr "No creeu pàgines de WordPress per a aquests slugs: es creen virtualment. Podeu eliminar les pàgines de Theme My Login amb els mateixos noms. Perfil i Preferits només tenen rewrite amb aquests mòduls actius."

msgid "Do not enable together with CleanTalk, Kadence captcha, or another reCAPTCHA on the same forms (double challenges / failed verifies)."
msgstr "No ho activeu juntament amb CleanTalk, captcha de Kadence o un altre reCAPTCHA als mateixos formularis."

msgid "Each box wants a full address that starts with https:// (a path such as /shop/ is not enough). Empty means keep the WordPress default for that case."
msgstr "Cada camp vol una adreça completa que comenci amb https:// (un camí com /shop/ no basta). Buit = valor per defecte de WordPress."

msgid "Each person turns it on from their own profile page (Profiles) or from Users → Profile in wp-admin. Checking the box and saving creates a key the first time. They type that key into an app such as Google Authenticator."
msgstr "Cada persona l’activa des del perfil (Perfils) o des d’Usuaris → Perfil a wp-admin. Marcar i desar crea la clau la primera vegada. L’introdueixen a una app com Google Authenticator."

msgid "Edit a slug below (letters, numbers, hyphens only), then click Save core settings (rewrites are flushed automatically)."
msgstr "Editeu un slug a sota (només lletres, números i guions) i feu clic a Desa la configuració del nucli (les regles es regeneren soles)."

msgid "Email"
msgstr "Correu electrònic"

msgid "Email Address"
msgstr "Adreça de correu"

msgid "Email confirmation"
msgstr "Confirmació per correu"

msgid "Email confirmation sends a link. The new person cannot log in until they open it."
msgstr "La confirmació per correu envia un enllaç. La persona nova no pot entrar fins que l’obri."

msgid "Email only"
msgstr "Només correu"

msgid "Email only creates a username from the email address. Username + email asks for both fields."
msgstr "Només correu crea el nom d’usuari a partir de l’adreça. Nom d’usuari + correu demana els dos camps."

msgid "Enable"
msgstr "Activa"

msgid "Enable lockouts"
msgstr "Activa els bloquejos"

msgid "Example. After login → Default: %1$s (everyone). Subscriber: %2$s (only subscribers; they ignore Default). Administrator: %3$s. After logout → Default: %1$s. After registration → Default: %4$s. Leave Administrator empty under After login if those users should follow Default."
msgstr "Exemple. Després d’entrar → Per defecte: %1$s (tothom). Subscriptor: %2$s (només subscriptors; ignoren Per defecte). Administrador: %3$s. Després de sortir → Per defecte: %1$s. Després del registre → Per defecte: %4$s. Deixeu Administrador buit a Després d’entrar si han de seguir Per defecte."

msgid "Example: a login prompt only guests see"
msgstr "Exemple: un avís d’accés que només veuen els visitants"

msgid "Example: a note only members see"
msgstr "Exemple: una nota que només veuen els membres"

msgid "Example: one role only"
msgstr "Exemple: només un rol"

msgid "Facebook"
msgstr "Facebook"

msgid "Facebook app ID"
msgstr "ID d’aplicació de Facebook"

msgid "Facebook app secret"
msgstr "Secret d’aplicació de Facebook"

msgid "Facebook apps"
msgstr "Apps de Facebook"

msgid "Failed tries allowed before a lockout starts."
msgstr "Intents fallits permesos abans de bloquejar."

msgid "Favorites"
msgstr "Preferits"

msgid "Favorites module is not available."
msgstr "El mòdul Preferits no està disponible."

msgid "Follow the numbered steps on each provider card. Copy the redirect URI shown there into that provider’s console."
msgstr "Seguiu els passos numerats de cada proveïdor. Copieu l’URI de redirecció a la consola d’aquell proveïdor."

msgid "Forms"
msgstr "Formularis"

msgid "Friendly URL check finished: permalinks are not Plain and the login rewrite rule is present."
msgstr "Comprovació d’URL amigables acabada: els enllaços no són Plain i la regla d’accés hi és."

msgid "Friendly URL check finished: rewrite rules were refreshed but the login rule is still missing. Open Settings → Permalinks and click Save Changes."
msgstr "Comprovació acabada: s’han refrescat les regles però falta la d’accés. Obriu Configuració → Enllaços permanents i deseu."

msgid "Friendly URLs are off. WordPress is using Plain permalinks, so addresses such as /login/ will not open."
msgstr "Les URL amigables estan desactivades. WordPress usa Plain, així que /login/ no s’obrirà."

msgid "Friendly URLs are on (current structure: %s). The login rewrite rule is present, so the preview addresses below can open."
msgstr "Les URL amigables estan actives (estructura: %s). Hi ha la regla d’accés; les adreces de previsualització poden obrir-se."

msgid "Frontend login, registration and account pages with optional premium modules. Drop-in replacement for Theme My Login."
msgstr "Pàgines frontend d’inici de sessió, registre i compte amb mòduls premium opcionals. Substitut de Theme My Login."

msgid "Frontend login, registration and account pages. Optional modules add redirection, moderation, security and more."
msgstr "Pàgines frontend d’inici de sessió, registre i compte. Els mòduls opcionals afegeixen redirecció, moderació, seguretat i més."

msgid "Frontend profile page so users can edit their account without using wp-admin."
msgstr "Pàgina de perfil al frontend perquè els usuaris editin el compte sense wp-admin."

msgid "Get New Password"
msgstr "Obtén una contrasenya nova"

msgid "Google"
msgstr "Google"

msgid "Google Cloud credentials"
msgstr "Credencials de Google Cloud"

msgid "Google client ID"
msgstr "ID de client de Google"

msgid "Google client secret"
msgstr "Secret de client de Google"

msgid "Google reCAPTCHA admin"
msgstr "Admin de Google reCAPTCHA"

msgid "Guests are redirected to the login page. Login, register and password URLs stay public."
msgstr "Els visitants es redirigeixen a l’inici de sessió. Les URL d’accés, registre i contrasenya continuen públiques."

msgid "Guests see nothing from that block. Logged-in users see the sentence."
msgstr "Els visitants no veuen res d’aquell bloc. Els usuaris connectats veuen la frase."

msgid "HTML emails"
msgstr "Correus HTML"

msgid "Hide wp-login.php"
msgstr "Amaga wp-login.php"

msgid "Hide wp-login.php conflicts with any plugin that renames or protects wp-login.php."
msgstr "Amagar wp-login.php xoca amb qualsevol plugin que reanomena o protegeix wp-login.php."

msgid "Hide wp-login.php returns 404 for the default login file. Use it only together with this plugin’s frontend login address."
msgstr "Amagar wp-login.php retorna 404 al fitxer d’accés per defecte. Useu-ho només amb l’adreça d’accés frontend d’aquest plugin."

msgid "How long the lockout lasts."
msgstr "Quant dura el bloqueig."

msgid "How to find Audience ID"
msgstr "Com trobar l’ID d’audiència"

msgid "How to use"
msgstr "Com usar-ho"

msgid "How to use modules"
msgstr "Com usar els mòduls"

msgid "Howdy, %s"
msgstr "Hola, %s"

msgid "If Profiles → Block wp-admin is on, users should enable 2FA on the frontend profile (not wp-admin)."
msgstr "Si Perfils → Bloquejar wp-admin està actiu, cal activar el 2FA al perfil frontend (no a wp-admin)."

msgid "If either box is on, Core → “Log users in after registration” is ignored for that signup. The visitor stays logged out until the pending step is finished. If both boxes are off, the Core option applies as usual."
msgstr "Si alguna casella està activa, Nucli → «Inicia sessió després del registre» s’ignora. El visitant roman desconnectat fins al pas pendent. Si totes dues estan desactivades, s’aplica l’opció del nucli."

msgid "If off, WordPress emails a generated password. If on, the register form includes password fields."
msgstr "Si està desactivat, WordPress envia una contrasenya generada. Si està activat, el formulari de registre inclou camps de contrasenya."

msgid "Import Theme My Login free settings (AJAX, login type, registration, passwords, auto-login, slugs). Shortcode [theme-my-login] is already aliased. Deactivate Theme My Login after verifying URLs."
msgstr "Importa la configuració gratuïta de Theme My Login (AJAX, tipus d’inici de sessió, registre, contrasenyes, auto-login, slugs). El shortcode [theme-my-login] ja està com a àlies. Desactiveu Theme My Login després de verificar les URL."

msgid "Import Theme My Login settings"
msgstr "Importa la configuració de Theme My Login"

msgid "In Facebook Login → Settings, paste the Facebook callback URL below into Valid OAuth Redirect URIs."
msgstr "A Facebook Login → Settings, enganxeu l’URL de callback de Facebook a Valid OAuth Redirect URIs."

msgid "In Settings → Basic, copy App ID and App Secret into the fields below, then Save."
msgstr "A Settings → Basic, copieu App ID i App Secret als camps de sota i deseu."

msgid "Installed plugins check: none of the plugins on this site match the known incompatibilities for this module."
msgstr "Comprovació de plugins: cap dels instal·lats coincideix amb incompatibilitats conegudes d’aquest mòdul."

msgid "Installed plugins that may clash:"
msgstr "Plugins instal·lats que poden xocar:"

msgid "Invalid logout request."
msgstr "Sol·licitud de tancament de sessió no vàlida."

msgid "Invalid social login request."
msgstr "Sol·licitud d’inici de sessió social no vàlida."

msgid "JPG, PNG, GIF or WebP."
msgstr "JPG, PNG, GIF o WebP."

msgid "Keep “Show on posts” checked to put Add/Remove at the end of each single post for logged-in users."
msgstr "Manteniu «Mostra a les entrades» marcat per posar Afegeix/Treu al final de cada entrada per a usuaris connectats."

msgid "Key to type into the app (Google Authenticator or similar):"
msgstr "Clau per introduir a l’app (Google Authenticator o similar):"

msgid "Leave a provider empty to hide its button. After saving, test from the login page."
msgstr "Deixeu un proveïdor buit per amagar-ne el botó. Després de desar, proveu des de la pàgina d’accés."

msgid "Leave this unchecked if the password is enough. Check it and click Save Profile to turn two-factor on. The key is created only when you save, not when you tick the box. After saving you will see a key: type it into an authenticator app. From the next login, the password alone is not enough — the site also asks for the 6-digit code from that app."
msgstr "Deixeu-ho desmarcat si basta la contrasenya. Marqueu-ho i feu clic a Desa el perfil per activar el doble factor. La clau es crea en desar, no en marcar. Després veureu una clau: introduïu-la a una app. Al proper inici, la contrasenya sola no basta: també cal el codi de 6 dígits."

msgid "Let users upload a local profile picture instead of only using Gravatar."
msgstr "Permet pujar una foto de perfil local en lloc d’usar només Gravatar."

msgid "List ID"
msgstr "ID de llista"

msgid "Lock accounts after failed logins, enforce password length, and optionally hide wp-login.php."
msgstr "Bloqueja després d’inicis fallits, obliga una longitud mínima de contrasenya i opcionalment amaga wp-login.php."

msgid "Lockout minutes"
msgstr "Minuts de bloqueig"

msgid "Log In"
msgstr "Inicia la sessió"

msgid "Log Out"
msgstr "Tanca la sessió"

msgid "Log in"
msgstr "Inicia la sessió"

msgid "Log users in after registration"
msgstr "Inicia la sessió dels usuaris després del registre"

msgid "Logged-in users can save favorite posts and view them on a dedicated page."
msgstr "Els usuaris connectats poden desar entrades preferides i veure-les en una pàgina dedicada."

msgid "Logged-in users open %s to edit display name, email and password. The path is the Profile slug under Core."
msgstr "Els usuaris connectats obren %s per editar nom visible, correu i contrasenya. El camí és l’slug de Perfil a Nucli."

msgid "Logged-in users see a button at the end of each single post. The list page uses the Favorites URL slug from Core settings."
msgstr "Els usuaris connectats veuen un botó al final de cada entrada. La llista usa l’slug de Preferits de Nucli."

msgid "Logged-in users see nothing from that block. Guests see the sentence."
msgstr "Els usuaris connectats no veuen res d’aquell bloc. Els visitants veuen la frase."

msgid "Login"
msgstr "Accés"

msgid "Login Protect asks for an email code after the password. Do not also require an authenticator code on the same accounts."
msgstr "Login Protect demana un codi per correu després de la contrasenya. No exigeixi també un codi d’autenticador als mateixos comptes."

