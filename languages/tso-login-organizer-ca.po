msgstr "Obrir Google Cloud → Credencials"

msgid "Open Google reCAPTCHA admin"
msgstr "Obrir admin de Google reCAPTCHA"

msgid "Open Mailchimp API keys"
msgstr "Obrir claus API de Mailchimp"

