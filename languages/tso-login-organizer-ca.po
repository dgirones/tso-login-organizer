msgstr "Restablir contrasenya"

msgid "Restrictions"
msgstr "Restriccions"

msgid "Return 404 on wp-login.php"
msgstr "Retornar 404 a wp-login.php"

msgid "SMTP / email-template plugins may still wrap or override outgoing mail after this filter runs."
msgstr "Plugins SMTP / plantilles de correu encara poden embolcallar o sobreescriure el correu després d’aquest filtre."

msgid "Save Password"
msgstr "Desa la contrasenya"

msgid "Save Profile"
msgstr "Desa el perfil"

msgid "Save core settings"
msgstr "Desa la configuració del nucli"

msgid "Save module settings"
msgstr "Desa la configuració del mòdul"

msgid "Save module settings, then open the login page and try the social button."
msgstr "Deseu la configuració del mòdul, obriu la pàgina d’accés i proveu el botó social."

msgid "Save modules"
msgstr "Desa els mòduls"

msgid "Secret key"
msgstr "Clau secreta"

msgid "Secret:"
msgstr "Secret:"

msgid "Security"
msgstr "Seguretat"

msgid "Send notification emails as HTML"
msgstr "Enviar els correus de notificació en HTML"

msgid "Send users to different URLs after login, logout or registration, optionally per role."
msgstr "Envia els usuaris a URL diferents després d’iniciar sessió, sortir o registrar-se, opcionalment per rol."

msgid "Sends subscriber email (and name if available) to Mailchimp’s API (see readme External services)."
msgstr "Envia el correu (i el nom si hi és) a l’API de Mailchimp (vegeu serveis externs al readme)."

msgid "Sends users to Google / Facebook / X and exchanges tokens with those APIs (see readme External services). Off until credentials are saved."
msgstr "Envia els usuaris a Google / Facebook / X i intercanvia tokens (vegeu serveis externs). Inactiu fins a desar credencials."

msgid "Sends visitor IP and token to Google for verification when forms are submitted (see readme External services)."
msgstr "Envia la IP i el token a Google per verificar quan s’envien els formularis (vegeu serveis externs al readme)."

msgid "Set App permissions to include users email if you want email on new accounts."
msgstr "Configureu els permisos de l’app per incloure el correu si voleu email als comptes nous."

msgid "Settings"
msgstr "Ajustaments"

msgid "Settings > Permalinks must not be \"Plain\" (use Post name or similar)."
msgstr "Arranjament > Enllaços permanents no pot ser «Simple» (useu Nom de l’entrada o similar)."

msgid "Shortcodes"
msgstr "Shortcodes"

msgid "Show add/remove favorite controls on single posts"
msgstr "Mostrar controls d’afegir/treure preferits a les entrades"

msgid "Show checkbox"
msgstr "Mostra la casella"

msgid "Show form links"
msgstr "Mostra els enllaços del formulari"

msgid "Show on posts"
msgstr "Mostra a les entrades"

msgid "Sign in with Google, Facebook or X using OAuth app credentials you provide."
msgstr "Inicia sessió amb Google, Facebook o X amb les credencials OAuth que proporcioneu."

msgid "Site key"
msgstr "Clau del lloc"

msgid "Skip the \"check your email\" step and sign the new user in immediately (not recommended with email confirmation / admin approval)."
msgstr "Omet el pas de «consulteu el correu» i inicia sessió de seguida (no recomanat amb confirmació / aprovació)."

msgid "Slug"
msgstr "Slug"

msgid "Social Login"
msgstr "Inici de sessió social"

