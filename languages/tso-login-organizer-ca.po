msgstr "Redirigeix usuaris sense edit_posts a la pàgina de perfil"

msgid "Redirection"
msgstr "Redirecció"

msgid "Register"
msgstr "Registra’t"

msgid "Registration complete. You may now log in."
msgstr "Registre complet. Ja podeu iniciar la sessió."

msgid "Registration confirmation will be emailed to you."
msgstr "La confirmació del registre s’enviarà al vostre correu."

msgid "Registration type"
msgstr "Tipus de registre"

msgid "Remember Me"
msgstr "Recorda’m"

msgid "Remove from favorites"
msgstr "Treu dels preferits"

