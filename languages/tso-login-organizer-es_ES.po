msgid "<strong>Error:</strong> Enter your current password to change your email or password, or to turn two-factor off."
msgstr "<strong>Error:</strong> Introduce tu contraseña actual para cambiar el correo o la contraseña, o para desactivar la verificación en dos pasos."

msgid "Current password"
msgstr "Contraseña actual"

msgid "Needed only to change your email or password, or to turn two-factor off."
msgstr "Solo hace falta para cambiar el correo o la contraseña, o para desactivar la verificación en dos pasos."

msgid "<strong>Error:</strong> Too many wrong two-factor codes. Please try again in a few minutes."
msgstr "<strong>Error:</strong> Demasiados códigos de verificación en dos pasos incorrectos. Inténtalo de nuevo dentro de unos minutos."

msgid "<strong>Error:</strong> This account uses two-factor authentication. Use an application password for XML-RPC."
msgstr "<strong>Error:</strong> Esta cuenta usa verificación en dos pasos. Usa una contraseña de aplicación para XML-RPC."

msgid "<strong>Error:</strong> The social login was cancelled or not allowed by the provider."
msgstr "<strong>Error:</strong> El inicio de sesión social se canceló o el proveedor no lo permitió."

msgid "<strong>Error:</strong> This confirmation link is invalid or has already been used."
msgstr "<strong>Error:</strong> Este enlace de confirmación no es válido o ya se ha usado."

msgid "<strong>Error:</strong> This confirmation link has expired. We have sent you a new one."
msgstr "<strong>Error:</strong> Este enlace de confirmación ha caducado. Te hemos enviado uno nuevo."

msgid "Always allowed IPs"
msgstr "IPs siempre permitidas"

msgid "An administrator approved your account. You can now log in."
msgstr "Un administrador ha aprobado tu cuenta. Ya puedes iniciar sesión."

msgid "Behind Cloudflare or another proxy every visitor can look like the same IP, so one attacker could lock everyone out. Pick the header your proxy sets. Only choose a header your server really overwrites."
msgstr "Detrás de Cloudflare u otro proxy todos los visitantes pueden parecer la misma IP y un atacante podría bloquear a todos. Elige la cabecera que establece tu proxy. Elige solo una cabecera que tu servidor sobrescriba realmente."

msgid "Cloudflare (CF-Connecting-IP)"
msgstr "Cloudflare (CF-Connecting-IP)"

msgid "Delete all plugin data when the plugin is deleted"
msgstr "Eliminar todos los datos del plugin al borrarlo"

msgid "Detected IP for your current request: %s"
msgstr "IP detectada para tu petición actual: %s"

msgid "For security, administrator accounts cannot be linked by email. Log in with your password and link the provider from your profile."
msgstr "Por seguridad, las cuentas de administrador no se pueden vincular por correo. Inicia sesión con tu contraseña y vincula el proveedor desde tu perfil."

msgid "One IP or IPv4 range (example 203.0.113.0/24) per line. These IPs are never locked out. Add your own IP here."
msgstr "Una IP o rango IPv4 (ejemplo 203.0.113.0/24) por línea. Estas IPs nunca se bloquean. Añade aquí tu propia IP."

msgid "Plugin data"
msgstr "Datos del plugin"

msgid "Server address (REMOTE_ADDR) — default"
msgstr "Dirección del servidor (REMOTE_ADDR) — por defecto"

msgid "Settings, two-factor keys, linked social accounts, avatars and favorites. Leave unchecked to keep them if you reinstall."
msgstr "Ajustes, claves de dos factores, cuentas sociales vinculadas, avatares y favoritos. Déjalo sin marcar para conservarlos si reinstalas."

msgid "Visitor IP source"
msgstr "Origen de la IP del visitante"

msgid "X-Forwarded-For (first address)"
msgstr "X-Forwarded-For (primera dirección)"

msgid "X-Real-IP"
msgstr "X-Real-IP"

msgid "Your account has been approved"
msgstr "Tu cuenta ha sido aprobada"
