msgstr "Seguridad"

msgid "Send notification emails as HTML"
msgstr "Enviar los correos de notificación en HTML"

msgid "Send users to different URLs after login, logout or registration, optionally per role."
msgstr "Envía a los usuarios a URL distintas tras iniciar sesión, salir o registrarse, opcionalmente por rol."

msgid "Sends subscriber email (and name if available) to Mailchimp’s API (see readme External services)."
msgstr "Envía el correo (y el nombre si hay) a la API de Mailchimp (ver servicios externos en el readme)."

msgid "Sends users to Google / Facebook / X and exchanges tokens with those APIs (see readme External services). Off until credentials are saved."
msgstr "Envía a los usuarios a Google / Facebook / X e intercambia tokens (ver servicios externos). Inactivo hasta guardar credenciales."

msgid "Sends visitor IP and token to Google for verification when forms are submitted (see readme External services)."
msgstr "Envía la IP y el token a Google para verificar al enviar formularios (ver servicios externos en el readme)."

msgid "Set App permissions to include users email if you want email on new accounts."
msgstr "Configura los permisos de la app para incluir el correo si quieres email en las cuentas nuevas."

msgid "Settings"
msgstr "Ajustes"

msgid "Settings > Permalinks must not be \"Plain\" (use Post name or similar)."
msgstr "Ajustes > Enlaces permanentes no puede ser «Simple» (usa Nombre de la entrada o similar)."

msgid "Shortcodes"
msgstr "Shortcodes"

